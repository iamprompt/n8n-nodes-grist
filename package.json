{
  "name": "@iamprompt/n8n-nodes-grist",
  "version": "0.1.2",
  "description": "n8n community node for Grist — create, read, update, upsert, and delete records in your Grist spreadsheet-database.",
  "license": "MIT",
  "homepage": "https://github.com/iamprompt/n8n-nodes-grist",
  "keywords": [
    "n8n-community-node-package",
    "grist",
    "database",
    "spreadsheet",
    "no-code",
    "automation"
  ],
  "author": {
    "name": "Supakarn Laorattanakul",
    "email": "opensource@iamprompt.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamprompt/n8n-nodes-grist.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/Grist.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Grist/Grist.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@n8n/node-cli": "^0.23.1",
    "eslint": "10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "3.8.3",
    "release-it": "19.2.4",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.58.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
